# ==========================================
# CommerceChain 360 - Root .gitignore
# ==========================================

# Virtual Environments & Python
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Temporary Files, Logs & Operating System
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# Large Non-Runtime Data & Generated Caches
data/raw/
data/processed/geolocation_clean.csv
data/processed/cache/*.parquet

# Explicitly keep pre-aggregated JSON centroid and translation dictionaries
!data/processed/cache/*.json

# IDE & Editor Artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

